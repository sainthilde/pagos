                </jsonProvider>
                <jsonProvider>
                    <fieldName>feign.headers</fieldName>
                    <value>%X{feign.headers}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>http.request.headers</fieldName>
                    <value>%X{http.request.headers}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>http.request.url.path</fieldName>
                    <value>%X{http.request.url.path}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>http.request.path.params</fieldName>
                    <value>%X{http.request.path.params}</value>
