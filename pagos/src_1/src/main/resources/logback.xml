                </jsonProvider>
                <jsonProvider>
                    <fieldName>http.request.body.content</fieldName>
                    <value>%X{http.request.body.content}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>http.response.body.content</fieldName>
                    <value>%X{http.response.body.content}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>http.request.referrer</fieldName>
                    <value>%X{http.request.referrer}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>error.stack_trace</fieldName>
                    <value>%X{error.stack_trace}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>message.topic</fieldName>
                    <value>%X{message.topic}</value>
                </jsonProvider>
                <jsonProvider>
