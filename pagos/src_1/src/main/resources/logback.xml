                    <value>%X{message.timestamp}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>message.payload</fieldName>
                    <value>%X{message.payload}</value>
                </jsonProvider>
                <jsonProvider>
                    <fieldName>job.name</fieldName>
                    <value>%X{job.name}</value>
                </jsonProvider>
                <jsonProvider>
